{
  "version": 2,
  "builds": [
    { "src": "site/**", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/dados/(.*)", "headers": { "cache-control": "public, max-age=0, must-revalidate" }, "dest": "/site/dados/$1" },
    { "src": "/", "dest": "/site/index.html" },
    { "src": "/(.*)", "dest": "/site/$1" }
  ]
}
